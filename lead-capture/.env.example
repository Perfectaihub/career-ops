# Cloudflare Pages secrets for the /api/lead function.
# Set these in CF Pages → Settings → Environment variables (Production),
# NOT in a committed file. This example documents the names only.

# Airtable personal access token. Scopes: data.records:write
# (add data.records:read for the dedupe-by-email lookup).
AIRTABLE_TOKEN=

# The Airtable base ID (looks like appXXXXXXXXXXXXXX).
AIRTABLE_BASE_ID=

# The table name. Defaults to "Leads" if unset.
AIRTABLE_TABLE=Leads
